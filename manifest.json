{
  "manifest_version": 3,
  "name": "foresttrip",
  "description": "숲나들e",
  "version": "1.0.0",
  "action": {
    "default_icon": "logo.png",
    "default_popup": "popup.html",
    "default_title": "숲나들e"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["https://www.foresttrip.go.kr/*"],
  "permissions": ["scripting", "tabs", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "popup.html"
  }
}
