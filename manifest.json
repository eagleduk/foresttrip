{
  "manifest_version": 3,
  "name": "Forest Trip",
  "description": "숲나들e",
  "version": "2.0.0",
  "action": {
    "default_icon": "logo.png",
    "default_popup": "popup.html",
    "default_title": "숲나들e"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["developer_clear.js", "extra_search.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["https://www.foresttrip.go.kr/*"],
  "permissions": [
    "activeTab",
    "webNavigation",
    "scripting",
    "tabs",
    "storage",
    "sidePanel",
    "declarativeContent"
  ],
  "side_panel": {
    "default_path": "popup.html"
  }
}
